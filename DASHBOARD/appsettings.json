{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Expressions" ],
    "Filter": [
      {
        // Drop EF Core's per-query SQL dumps, which say nothing once a query succeeds and carry
        // parameter values (emails, tokens) into the log file. A *failed* command is kept: that
        // entry names the statement that broke and is the first thing worth reading when the
        // database rejects something.
        "Name": "ByExcluding",
        "Args": {
          "expression": "SourceContext = 'Microsoft.EntityFrameworkCore.Database.Command' and @l not in ['Error', 'Fatal']"
        }
      }
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        // Superseded by UseSerilogRequestLogging's single summary line per request.
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "MassTransit": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/dashboard-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 52428800,
          "retainedFileCountLimit": 31,
          "shared": true,
          "flushToDiskInterval": "00:00:02",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {SourceContext} — {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        // Errors as readable text — this is the one to open when something breaks.
        "Name": "File",
        "Args": {
          "path": "logs/errors/dashboard-error-.log",
          "restrictedToMinimumLevel": "Error",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {RequestPath}{NewLine}  {SourceContext}{NewLine}  {Message:lj}{NewLine}{Exception}{NewLine}────────────────────────────────────────────────────────────────────────{NewLine}"
        }
      },
      {
        // Same errors as CLEF JSON — for querying by machine (Seq/Loki) rather than reading.
        "Name": "File",
        "Args": {
          "path": "logs/errors/dashboard-error-json-.log",
          "restrictedToMinimumLevel": "Error",
          "rollingInterval": "Day",
          // Half the text log's retention: this copy exists to be queried by a tool, and the
          // readable file next to it stays the full 90 days for after-the-fact investigation.
          "retainedFileCountLimit": 45,
          "shared": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "",
    "Redis": "localhost:6379"
  },
  "JwtSettings": {
    "Secret": "CHANGE_THIS_SECRET_MIN_32_CHARS_LONG!",
    "Issuer": "dashboard-api",
    "Audience": "dashboard-spa",
    "ExpiresInHours": 8,
    "RefreshTokenExpiresInDays": 7
  },
  "Invitation": {
    "TokenTtlMinutes": 5,
    "FrontendBaseUrl": "http://localhost:4200",
    "RateLimit": {
      "PermitLimit": 10,
      "WindowMinutes": 15,
      "SegmentsPerWindow": 3
    }
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "Username": "REPLACE_WITH_EMAIL",
    "Password": "REPLACE_WITH_APP_PASSWORD",
    "FromEmail": "noreply@nflow.app"
  },
  "Google": {
    "ClientId": ""
  },
  "RabbitMq": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "guest"
  },
  "Defaults": {
    "GoogleUserAvatarClass": "bg-sky-600"
  },
  "InternalApi": {
    "Token": "CHANGE_THIS_INTERNAL_TOKEN_MIN_32_CHARS!"
  },
  "HubChat": {
    "BaseUrl": "http://localhost:55924",
    "InternalToken": "CHANGE_THIS_INTERNAL_TOKEN_MIN_32_CHARS!",
    "FrontendBaseUrl": "http://localhost:4202"
  },
  "NMate": {
    // NMate AI assistant (repo SUPPORT). Empty BaseUrl = disabled (/api/v1/nmate/* → 404, widget hidden).
    // Dev: http://localhost:5160 · Docker: http://support-api:8080
    "BaseUrl": "",
    // Must equal InternalClients[product=dashboard].Token on the NMate side — user-secrets / .env.
    "InternalToken": "",
    "TimeoutSeconds": 120,
    "RateLimit": {
      "PermitLimit": 5,
      "WindowMinutes": 1
    }
  },
  "MinIO": {
    "Endpoint": "http://localhost:9100",
    "AccessKey": "REPLACE_WITH_MINIO_ACCESS_KEY",
    "SecretKey": "REPLACE_WITH_MINIO_SECRET_KEY",
    "AvatarBucket": "dashboard-avatars",
    "PublicBaseUrl": "http://localhost:9100"
  }
}
