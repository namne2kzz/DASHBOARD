# ── Secrets & local overrides ──────────────────────────────────────────────
.env
.claude/settings.local.json
.claude/self-test.local.json

# ── DB backups (local only, never commit) ──────────────────────────────────
backups/*
!backups/.gitkeep

# ── IDE / tooling ───────────────────────────────────────────────────────────
.vs/
.idea/
*.user
*.suo

# ── Playwright MCP output (screenshots, snapshots, console logs) ────────────
.playwright-mcp/

# ── Temporary screenshots / debug images in project root ───────────────────
*.png
*.jpg
*.jpeg
!**/assets/**/*.png
!**/assets/**/*.jpg

# ── .NET build outputs ──────────────────────────────────────────────────────
**/bin/
**/obj/

# ── .NET local/dev appsettings (may contain real connection strings) ─────────
**/appsettings.Development.json
**/appsettings.Local.json
**/appsettings.*.local.json
*.pubxml
*.pubxml.user

# ── Angular / Node ──────────────────────────────────────────────────────────
DASHBOARD.VIEW/node_modules/
DASHBOARD.VIEW/dist/
DASHBOARD.VIEW/.angular/

# ── Serilog output (rolling file sinks — see docs/LOGGING-DESIGN.md) ─────────
logs/
**/logs/

# ── Test results ─────────────────────────────────────────────────────────────
TestResults/
coverage/
*.trx

# ── Docker & misc ───────────────────────────────────────────────────────────
.env.*
!.env.example
!.env.prod.example
