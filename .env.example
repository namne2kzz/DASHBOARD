# Copy to ".env" (same folder as docker-compose.yml). Docker Compose reads it automatically.
# .env is git-ignored — never commit real secrets.

MSSQL_SA_PASSWORD=Your_strong_Pass123
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ─── HUB integration — giá trị phải khớp với HUB/.env ──────────────────────
# JWT secret dùng chung (phải bằng JWT_SECRET trong HUB/.env).
JWT_SECRET=change-me-must-match-hub-exactly-min-32-chars

# Token HUB → DASHBOARD (phải bằng INTERNAL_API_TOKEN trong HUB/.env).
INTERNAL_API_TOKEN=change-me-shared-with-hub-internal-api

# Token DASHBOARD → HUB Chat (phải bằng HUB_CHAT_INTERNAL_TOKEN trong HUB/.env).
HUB_CHAT_INTERNAL_TOKEN=change-me-shared-with-hub-chat
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# --- GitHub connection for project "DASH" (used only by the "api" container profile) ---
GITHUB_REPO_URL_DASH=https://github.com/REPLACE_WITH_OWNER/REPLACE_WITH_REPO.git
GITHUB_TOKEN_DASH=REPLACE_WITH_GITHUB_PAT

# --- MCP: mssql-mcp-node (read by the MCP server itself via dotenv, not by docker-compose) ---
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=Your_strong_Pass123
MSSQL_DATABASE=DASHBOARD
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true
MSSQL_ENABLE_WRITES=false
