# DASHBOARD — .env for the PRODUCTION server.
#
# Copy to `.env` next to docker-compose.prod.yml on the server, then fill in real values.
# How this differs from .env.example (local): no MCP/MSSQL_* variables (those drive
# mssql-mcp-node on a dev machine), and it adds DASHBOARD_TAG + GHCR_OWNER.
#
# This file holds secrets — chmod 600, never commit it, never bake it into an image.

# ─── Image registry ──────────────────────────────────────────────────────────
# GitHub user/org that owns the GHCR packages (the part after ghcr.io/).
GHCR_OWNER=namne2kzz

# THE ONLY LINE CD REWRITES. Do not edit by hand except for a manual rollback.
# Value is the first 7 characters of the git SHA. Leave "latest" initially; CD overwrites it.
DASHBOARD_TAG=latest

# ─── Database ────────────────────────────────────────────────────────────────
MSSQL_SA_PASSWORD=REPLACE_strong_password_min_8_chars_with_upper_lower_digit

# ─── RabbitMQ (shared with HUB) ──────────────────────────────────────────────
RABBITMQ_USER=REPLACE_rabbit_user
RABBITMQ_PASS=REPLACE_rabbit_password

# ─── MinIO (avatar object storage) ───────────────────────────────────────────
MINIO_ACCESS_KEY=REPLACE_minio_user
MINIO_SECRET_KEY=REPLACE_minio_password_min_8_chars
# URL the browser uses to fetch avatars — must be reachable from the public internet.
MINIO_PUBLIC_URL=https://storage.example.com

# ─── HUB integration — these three MUST match HUB/.env on the same server ────
# Shared JWT secret so HUB can validate tokens DASHBOARD issues.
JWT_SECRET=REPLACE_min_32_chars_must_match_hub_exactly

# Token the HUB DashboardGateway sends when calling DASHBOARD /internal/v1/*.
INTERNAL_API_TOKEN=REPLACE_min_32_chars_must_match_hub

# Token DASHBOARD sends when calling HUB Chat /internal/channels/*.
HUB_CHAT_INTERNAL_TOKEN=REPLACE_min_32_chars_must_match_hub

# ─── Public URLs ─────────────────────────────────────────────────────────────
DASHBOARD_FRONTEND_URL=https://dashboard.example.com
HUB_FRONTEND_URL=https://hub.example.com
# Host port for the dashboard-web nginx container (the reverse proxy targets this).
WEB_PORT=4201

# ─── Google OAuth (client id — not a secret) ─────────────────────────────────
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# ─── GitHub integration for project "DASH" (optional) ────────────────────────
GITHUB_REPO_URL_DASH=https://github.com/OWNER/REPO.git
GITHUB_TOKEN_DASH=REPLACE_WITH_GITHUB_PAT
